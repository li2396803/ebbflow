{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "checkJs": false,
    "strict": false,
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": []
  },
  "include": ["web/js/**/*.js", "server/**/*.mjs", "lib/**/*.mjs", "scripts/**/*.mjs"],
  "exclude": ["node_modules", "web/dist", "site", "web/_shots", "web/_mock"]
}
