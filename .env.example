# ─────────────────────────────────────────────────────────────
# Tushare Pro token —— 必需。
#   · 深市数据的唯一来源（官方深交所接口没有历史数据）
#   · 沪市数据的第二参照（交叉校验）与单位净值（金额口径）
#   申请：https://tushare.pro/user/token
#   本地：复制本文件为 .env 并填入；.env 已在 .gitignore 中
#   CI：仓库 Settings → Secrets and variables → Actions → 新建 TUSHARE_TOKEN
#   fork 本仓库时**必须**自己配置，否则 daily 工作流会直接失败并提示
# ─────────────────────────────────────────────────────────────
TUSHARE_TOKEN=your_token_here

# 抓取纪律（可选，单位：次/分钟、次）
# 全局令牌桶：跨并发共享，用来"限制抓取频率"
# TUSHARE_RPM=120
# 单次运行最多调用多少次（防止一次跑飞了）
# TUSHARE_MAX_CALLS_PER_RUN=800
# 每日预算：计数持久化在 SQLite 的 meta 表（ts:calls:<日期>）
# TUSHARE_DAILY_BUDGET=4000

# 本地服务端口（可选）
# PORT=5188
