{
  "name": "ebbflow",
  "version": "3.11.2",
  "private": true,
  "description": "Ebbflow · ETF 细分行业资金流向：沪深全市场 ETF 份额/规模/净流入看板，两源数据管道 + 静态站点 + 本地服务，自动更新与交叉校验",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node server.mjs",
    "update": "node scripts/update.mjs",
    "build": "node scripts/build.mjs",
    "backfill": "node scripts/backfill.mjs",
    "reconcile": "node scripts/reconcile.mjs",
    "test": "node tests/runner.mjs",
    "verify:origin": "node scripts/verify-origin.mjs",
    "lint": "node scripts/lint.mjs",
    "classify": "node scripts/classify.mjs --v2",
    "tag": "node scripts/tag-v2.mjs",
    "palette": "node scripts/palette-v2.mjs",
    "quotes": "node scripts/backfill-quotes.mjs",
    "build:web": "vite build",
    "typecheck": "tsc -p jsconfig.json",
    "audit": "node scripts/audit-data.mjs",
    "repair": "node scripts/repair-generated.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "author": "dreemetoo <https://github.com/li2396803>",
  "homepage": "https://li2396803.github.io/ebbflow/",
  "repository": {
    "type": "git",
    "url": "https://github.com/li2396803/ebbflow.git"
  },
  "dependencies": {
    "echarts": "^5.5.0"
  }
