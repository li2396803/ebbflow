# 运行时产物（pid / 日志 / 锁）
.run/

# 每日原始份额快照（体积大、可重新抓取）
data/shares/

# 上次运行标记（每台机器各自生成）
# data/lastrun.json 是 v2 的文件名（scripts/update.mjs 只写这一个），两个都忽略
data/last-run.json
data/lastrun.json
data/lastrun.json.tmp

# 更新互斥锁（update.mjs 运行时临时创建）
data/.update.lock/

# 依赖（本项目零依赖，保留以防将来）
node_modules/

# macOS
.DS_Store

# 校验截图
verify/shots/

# playwright-cli 临时目录
.playwright-cli/

# 本地密钥
.env

# 本地 SQLite 缓存（可由原始快照重建）
data/etf.db
data/etf.db-*

# 构站时 atomic 写入的中间态（进程被 kill 时可能残留，别提交）
*.tmp

# 站点数据产物（由 npm run build 生成，不入库）
site/data/
# 旧版图表分片
site/charts/

# 前端自测用的 mock 与截图
web/_mock/
web/_shots/
