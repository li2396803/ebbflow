# 统一换行符：仓库里全是文本，Windows 上检出也给 LF，避免 CRLF 污染 diff 和 shell 脚本
* text=auto eol=lf

*.sh    text eol=lf
*.mjs   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.plist text eol=lf
.env.example text eol=lf

# 二进制/不宜换行转换
*.db    binary
*.db-wal binary
*.db-shm binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary

# 第三方压缩产物：算进语言统计没意义
site/echarts.min.js linguist-vendored
site/charts/*.js    linguist-vendored
tools/original-charts/*.js linguist-generated
